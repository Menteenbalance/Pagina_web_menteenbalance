# Copia este archivo como .env.local para desarrollo, y carga los mismos
# valores en Vercel → Project → Settings → Environment Variables.

# Envío de correos (https://resend.com). Sin esta clave, en desarrollo el
# correo solo se muestra en la consola.
RESEND_API_KEY=

# Destinatario y remitente del formulario
CONTACT_TO_EMAIL=ignaciacanessa@menteenbalance.com
# Debe ser de un dominio verificado en Resend
CONTACT_FROM_EMAIL="Mente en Balance <formulario@menteenbalance.com>"

# Rate limit compartido (Upstash Redis). En Vercel, al conectar Upstash desde
# Storage/Marketplace se crean KV_REST_API_URL y KV_REST_API_TOKEN solas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Texto secreto cualquiera, para anonimizar las IPs
RATE_LIMIT_SALT=
