# Copia este archivo como .env.local para desarrollo, y carga los mismos
# valores en Vercel → Project → Settings → Environment Variables.

# Dirección pública del sitio (opcional). Si no se define, se usa la que
# Vercel entrega en cada build (VERCEL_PROJECT_PRODUCTION_URL: el dominio
# propio o el .vercel.app). Solo defínela para forzar una dirección.
# VITE_SITE_URL=https://menteenbalance.cl

# Contenido del panel y límite de intentos de inicio de sesión (Upstash Redis).
# En Vercel, al conectar Upstash desde Storage/Marketplace se crean
# KV_REST_API_URL y KV_REST_API_TOKEN solas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Texto secreto cualquiera, para anonimizar las IPs de los intentos de inicio de sesión
RATE_LIMIT_SALT=

# ── Panel de administración (/admin) ────────────────────────────
# Cuenta de la administradora. En desarrollo, si no se definen, se usa
# admin@local / balance-local. En Vercel son OBLIGATORIAS.
ADMIN_EMAIL=
# Contraseña larga (mínimo 12 caracteres; idealmente una frase)
ADMIN_PASSWORD=
# Texto aleatorio largo para firmar la sesión (ej: 64 caracteres al azar)
SESSION_SECRET=

# Correos del panel: enlace para recuperar la contraseña y aviso de inicio
# de sesión desde un dispositivo nuevo (https://resend.com; en Vercel se
# conecta desde el Marketplace y crea RESEND_API_KEY sola). Sin esta clave,
# en desarrollo los correos se muestran en la consola.
RESEND_API_KEY=
# (Opcional) Remitente; debe ser de un dominio verificado en Resend.
# Por defecto: Mente en Balance <panel@menteenbalance.cl>
# CORREO_REMITENTE="Mente en Balance <panel@menteenbalance.cl>"

# Fotos del Diario (Vercel → Storage → Blob). Se crea sola al conectarlo.
# Vercel crea BLOB_STORE_ID al conectar el store (autenticación OIDC).
# BLOB_READ_WRITE_TOKEN solo se usa con stores antiguos o fuera de Vercel.
BLOB_READ_WRITE_TOKEN=

# (Opcional) ID del Blob Store PÚBLICO para las fotos, ej: store_AbC123...
# Úsalo solo si BLOB_STORE_ID quedó apuntando a otro store y Vercel no deja editarlo.
# FOTOS_BLOB_STORE_ID=

# ── Respaldo semanal automático (vercel.json → crons) ───────────
# Texto aleatorio largo (16+ caracteres). Vercel lo envía al llamar
# /api/cron/respaldo; sin esta variable el respaldo automático no corre.
CRON_SECRET=
